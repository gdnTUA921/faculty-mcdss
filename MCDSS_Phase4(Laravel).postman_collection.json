              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department_id\": \"{{department_id}}\",\n  \"title\": \"Phase 4 Closed Position\",\n  \"target_applicant_type\": \"both\",\n  \"slots_available\": 1,\n  \"status\": \"closed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/positions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('closed_position_id', pm.response.json().id);"
                ]
              }
            }
          ]
