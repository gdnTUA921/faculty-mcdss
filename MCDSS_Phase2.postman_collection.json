            "description": "Regression check: this route (/api/criterion-options/{id}) is flat -- no position or criterion segment -- but the controller used to require both, so this always 404'd."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
