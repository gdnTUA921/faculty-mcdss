          ]
        }
      ]
    },
    {
      "name": "5. Guard Rails (Negative Tests)",
      "item": [
        {
          "name": "Non-Admin (Director) Cannot Create Position",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{director_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department_id\": \"{{department_id}}\",\n  \"title\": \"Should Not Be Created\",\n  \"target_applicant_type\": \"both\",\n  \"slots_available\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/positions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Position Without department_id Rejected",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Missing Department\",\n  \"target_applicant_type\": \"both\",\n  \"slots_available\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/positions",
            "description": "Regression check: department_id is NOT NULL in the DB but used to be entirely absent from validation, so this used to blow up as an unhandled 500 DB integrity error instead of a clean 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422 (regression check -- used to be an unhandled 500)', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid target_applicant_type Value Rejected",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department_id\": \"{{department_id}}\",\n  \"title\": \"Bad Enum Value\",\n  \"target_applicant_type\": \"external_applicant\",\n  \"slots_available\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/positions",
            "description": "Regression check: 'external_applicant' used to be the only value validation accepted, but it doesn't match the Postgres enum (external/internal/both), so it used to crash as a 500 DB error instead of a clean 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422 (regression check -- used to be an unhandled 500)', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Zero-Weight Criterion Rejected",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zero Weight\",\n  \"data_type\": \"numeric\",\n  \"weight\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/positions/{{position_id}}/criteria",
            "description": "DB CHECK constraint requires weight > 0 (strictly), but validation used to allow weight=0. Confirms the gt:0 fix."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422 (weight must be greater than 0)', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
