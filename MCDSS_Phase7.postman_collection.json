      "name": "2. Phase 7 - Assignment Run (ILP, external applicants)",
      "item": [
        {
          "name": "[Guard Rail] Applicant Cannot Trigger Assignment Run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_a_token}}"
              }
            ],
            "url": "{{base_url}}/api/assignment-runs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hiring_round_id\": \"{{hiring_round_id}}\",\n  \"scope_applicant_type\": \"external\",\n  \"scope_position_ids\": [\n    \"{{position_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "POST /api/assignment-runs is in the role:admin,director group per routes/api.php."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "[Guard Rail] FastAPI Rejects Missing Service Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{fastapi_url}}/run-assignment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hiring_round_id\": \"{{hiring_round_id}}\",\n  \"scope_applicant_type\": \"external\",\n  \"scope_position_ids\": [\n    \"{{position_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
