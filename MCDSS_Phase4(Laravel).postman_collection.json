      ]
    },
    {
      "name": "2. Applicant Draft & Submit Flow",
      "item": [
        {
          "name": "Register External Applicant",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('applicant_email', `phase4.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('applicant_token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Phase4\",\n  \"last_name\": \"Applicant\",\n  \"email\": \"{{applicant_email}}\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/register"
          }
        },
        {
          "name": "Get Position Form",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              }
            ],
            "url": "{{base_url}}/api/positions/{{position_id}}/form"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Two fields returned', () => pm.expect(json.fields.length).to.eql(2));",
                  "const selectField = json.fields.find(f => f.data_type === 'select');",
                  "pm.test('Select field has options', () => pm.expect(selectField.options.length).to.eql(1));",
                  "const numericField = json.fields.find(f => f.data_type === 'numeric');",
                  "pm.test('Numeric field has no options', () => pm.expect(numericField.options.length).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Draft Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"position_id\": \"{{position_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Status is draft', () => pm.expect(json.status).to.eql('draft'));",
                  "pm.collectionVariables.set('application_id', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Draft Again (idempotent, expect 200 + same id)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"position_id\": \"{{position_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 (not 201 -- idempotent)', () => pm.response.to.have.status(200));",
                  "pm.test('Same application id returned', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('application_id')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save Form Responses",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responses\": [\n    { \"criterion_id\": \"{{criterion_numeric_id}}\", \"raw_value\": \"5\" },\n    { \"criterion_id\": \"{{criterion_select_id}}\", \"raw_value\": \"phd\" }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/applications/{{application_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Two responses saved', () => pm.expect(pm.response.json().data.form_responses.length).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Saved Responses (draft resumption)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              }
            ],
            "url": "{{base_url}}/api/applications/{{application_id}}/responses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Two responses returned', () => pm.expect(pm.response.json().length).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "[Guard Rail] Non-Owner Cannot View Responses",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('second_applicant_token')) {",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('base_url') + '/api/register',",
                  "        method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: { mode: 'raw', raw: JSON.stringify({ first_name: 'Second', last_name: 'Applicant', email: `phase4.second.${Date.now()}@example.com`, password: 'password123', password_confirmation: 'password123' }) }",
                  "    }, (err, res) => {",
                  "        if (!err && res) pm.collectionVariables.set('second_applicant_token', res.json().token);",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 (not this applicant\\'s application)', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{second_applicant_token}}"
              }
            ],
            "url": "{{base_url}}/api/applications/{{application_id}}/responses"
          }
        },
        {
          "name": "Submit Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              }
            ],
            "url": "{{base_url}}/api/applications/{{application_id}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is applied', () => pm.expect(pm.response.json().data.status).to.eql('applied'));"
                ]
              }
            }
          ]
        },
        {
          "name": "[Guard Rail] Cannot Submit Twice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              }
            ],
            "url": "{{base_url}}/api/applications/{{application_id}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422 (already submitted)', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "[Guard Rail] Cannot Edit Responses After Submit",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responses\": [\n    { \"criterion_id\": \"{{criterion_numeric_id}}\", \"raw_value\": \"99\" }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/applications/{{application_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422 (locked after submit)', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Draft Against Closed Position, Then Submit (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{second_applicant_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"position_id\": \"{{closed_position_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/applications",
            "description": "Draft creation against a closed position is expected to SUCCEED (201) -- only submit is gated on position status, per design. The test script below chains the submit call automatically to verify it's rejected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Draft creation succeeds even though position is closed', () => pm.response.to.have.status(201));",
                  "const draftId = pm.response.json().id;",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('base_url') + '/api/applications/' + draftId + '/submit',",
                  "    method: 'POST',",
                  "    header: { Authorization: 'Bearer ' + pm.collectionVariables.get('second_applicant_token') }",
                  "}, (err, res) => {",
                  "    pm.test('Submit against closed position is rejected (422)', () => {",
                  "        pm.expect(res.code).to.eql(422);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Internal Staff Account (for applicant-type guard rail)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('internal_staff_email', `phase4.staff.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Internal\",\n  \"last_name\": \"Staff\",\n  \"email\": \"{{internal_staff_email}}\",\n  \"role\": \"internal_applicant\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/admin/staff-accounts"
          }
        },
        {
          "name": "Fetch Temp Password (via Mailpit API)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mailpit_url}}/api/v1/messages?limit=25"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.collectionVariables.get('internal_staff_email');",
                  "const messages = (pm.response.json().messages) || [];",
                  "const match = messages.find(m => (m.To || []).some(t => t.Address === email));",
                  "pm.test('Account-created email found', () => pm.expect(match).to.not.be.undefined);",
                  "if (match) {",
                  "    pm.sendRequest({ url: pm.collectionVariables.get('mailpit_url') + '/api/v1/message/' + match.ID, method: 'GET' }, (err, res) => {",
                  "        if (!err && res) {",
                  "            const html = res.json().HTML || '';",
                  "            const tokenMatch = html.match(/<strong>([^<]+)<\\/strong>/);",
                  "            if (tokenMatch) pm.collectionVariables.set('internal_staff_temp_password', tokenMatch[1].trim());",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Internal Staff, Then Create+Submit Draft on External-Only Position (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{internal_staff_email}}\",\n  \"password\": \"{{internal_staff_temp_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.collectionVariables.set('internal_staff_token', token);",
                  "const positionId = pm.collectionVariables.get('position_id');",
                  "const baseUrl = pm.collectionVariables.get('base_url');",
                  "pm.sendRequest({",
                  "    url: baseUrl + '/api/applications',",
                  "    method: 'POST',",
                  "    header: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ position_id: positionId }) }",
                  "}, (err, draftRes) => {",
                  "    const draftId = draftRes.json().id;",
                  "    pm.sendRequest({",
                  "        url: baseUrl + '/api/applications/' + draftId + '/submit',",
                  "        method: 'POST',",
                  "        header: { Authorization: 'Bearer ' + token }",
                  "    }, (err2, submitRes) => {",
                  "        pm.test('Submit rejected: position is external-only, applicant is internal (422)', () => {",
                  "            pm.expect(submitRes.code).to.eql(422);",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Documents",
      "item": [
        {
          "name": "Upload Document (ATTACH A REAL FILE MANUALLY)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "document_type",
                  "value": "transcript",
                  "type": "text"
                },
                {
                  "key": "application_id",
                  "value": "{{application_id}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{base_url}}/api/documents",
            "description": "MANUAL STEP: open the Body tab and select a real file (a real .pdf/.png/.jpg/.doc/.docx) for the 'file' field before sending -- Postman collections can't embed binary content, and a fake file with a spoofed extension will be correctly rejected since Laravel's mimes: rule checks actual content."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('document_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              }
            ],
            "url": "{{base_url}}/api/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const uploaded = json.find(d => d.id === pm.collectionVariables.get('document_id'));",
                  "pm.test('Uploaded document appears in list', () => pm.expect(uploaded).to.not.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "[Guard Rail] Non-Owner Cannot Delete Document",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{second_applicant_token}}"
              }
            ],
            "url": "{{base_url}}/api/documents/{{document_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Document (owner)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              }
            ],
            "url": "{{base_url}}/api/documents/{{document_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "[Guard Rail] Disallowed File Type Rejected (ATTACH A .txt OR .exe MANUALLY)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{applicant_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "document_type",
                  "value": "transcript",
                  "type": "text"
                }
              ]
            },
            "url": "{{base_url}}/api/documents",
            "description": "MANUAL STEP: attach any file NOT in the allowed list (pdf,doc,docx,jpg,jpeg,png) -- e.g. a .txt file."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422 (disallowed mime type)', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}